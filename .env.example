# Local development database (SQLite)
DATABASE_URL="file:./dev.db"

# Authentication secret. Use a unique random value in every deployment.
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"

# Local application URL
NEXTAUTH_URL="http://localhost:3000"

# Canonical public URL used for metadata and Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Production PostgreSQL only:
# DATABASE_URL="postgresql://user:password@host:5432/blog?pgbouncer=true"
# DIRECT_URL="postgresql://user:password@host:5432/blog"