# MongoDB Database connection string
# For local MongoDB replica set:
DATABASE_URL="mongodb://127.0.0.1:27018/blog?replicaSet=rs0&directConnection=true"
# Or for MongoDB Atlas:
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/blog?retryWrites=true&w=majority"

# Authentication secret. Use a unique random value in every deployment.
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"

# Local application URL
NEXTAUTH_URL="http://localhost:3000"

# Canonical public URL used for metadata and Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
